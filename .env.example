# ─────────────────────────────────────────────────────────────────────────────
# Kiwi Ledger — environment variables
# Copy to .env.local for local dev; add the same keys in Vercel → Settings →
# Environment Variables for production. Everything is optional: with nothing
# set, the app runs with mock bank data, a local JSON store and offline chat.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Project Settings → API) ────────────────────────────────────────
# Without these the app uses a local JSON file (.data/db.json) and no login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the daily cron to act on your behalf. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=
# The only email allowed to sign in (magic link). Also used by the cron job.
OWNER_EMAIL=

# ── Akahu (https://my.akahu.nz/developers → your personal app) ───────────────
# Both tokens + Supabase configured => live bank data. Otherwise mock data.
AKAHU_APP_TOKEN=
AKAHU_USER_TOKEN=
# auto (default) = live when tokens exist, mock otherwise. "mock" forces mock.
AKAHU_MODE=auto

# ── Anthropic (https://console.anthropic.com → API keys) ─────────────────────
# Without it the chat uses a limited offline pattern-matcher.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-5.
CLAUDE_MODEL=claude-sonnet-5

# ── Vercel cron ──────────────────────────────────────────────────────────────
# Any long random string (e.g. `openssl rand -hex 32`). Vercel sends it as
# "Authorization: Bearer <CRON_SECRET>" to /api/cron/sync.
CRON_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
# Where the demo-mode JSON store lives (default ./.data, or /tmp on Vercel).
# LOCAL_DATA_DIR=
